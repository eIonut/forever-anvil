---
// Every recipe page, grouped by profession, with a search box.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import IndexSearch from "../../components/IndexSearch.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import Wowhead from "../../components/Wowhead.astro";
import { loadCatalog, type Recipe } from "../../data/catalog";
import { num } from "../../lib/format";
import { professionAnchor, recipeUrl } from "../../lib/urls";
import { tooltipAttrs } from "../../lib/wowhead";

const c = loadCatalog();
const byProf: Record<string, Recipe[]> = {};
for (const r of c.recipes) (byProf[r.prof] ||= []).push(r);
const profs = Object.keys(byProf).sort();
---
<BaseLayout
  title="WoW: Forever Recipes: Costs & Profit for Every Profession | Forever Anvil"
  description={`All ${num(c.recipes.length)} WoW: Forever crafting recipes with live material costs and profit on every auction house.`}
  page="recipes"
>
  <PageHero icon="recipes" eyebrow="Crafting" title="WoW: Forever recipes" facts={[{ icon: "recipes", text: "One page per recipe" }, { icon: "prices", text: "Cost and profit on every Auction House" }]}>
    {num(c.recipes.length)} recipes across {profs.length} professions, each with today's material cost and profit on every Auction House.
  </PageHero>

  <div class="wrap section item-index">
    <IndexSearch label="Find a recipe" placeholder="e.g. Bolt of Linen Cloth" />
    <nav class="az" aria-label="Jump to profession">{profs.map((p) => <a href={`#${professionAnchor(p)}`}>{p}</a>)}</nav>
    {profs.map((p) => (
      <Fragment>
        <h2 id={professionAnchor(p)}>{p}{" "}<span class="faint">({byProf[p].length})</span></h2>
        <ul style={`--rows:${Math.ceil(byProf[p].length / 3)}`}>
          {byProf[p].slice().sort((a, b) => a.name.localeCompare(b.name)).map((r) => (
            <li><a href={recipeUrl(r.id, r.name)} {...tooltipAttrs(r.item)}><ItemIcon id={r.item} />{r.name}</a></li>
          ))}
        </ul>
      </Fragment>
    ))}
    <p class="faint">Data provided by Blizzard Entertainment. Prices as of {c.asOf}.</p>
  </div>
  <Wowhead />
</BaseLayout>
