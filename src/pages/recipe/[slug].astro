---
// One page per recipe (/recipe/2359-bolt-of-linen-cloth): materials with today's prices,
// and the profit on every auction house. Built from ./out (see src/data/catalog.ts).
import BaseLayout from "../../layouts/BaseLayout.astro";
import LiveFreshness from "../../components/LiveFreshness.astro";
import AdSlot from "../../components/AdSlot.astro";
import ItemLink from "../../components/ItemLink.astro";
import CopyName from "../../components/CopyName.astro";
import ItemTitleIcon from "../../components/ItemTitleIcon.astro";
import Money from "../../components/Money.astro";
import PlanButton from "../../components/PlanButton.astro";
import Wowhead from "../../components/Wowhead.astro";
import { itemPageUrl, loadCatalog, priceOn, primaryPrices } from "../../data/catalog";
import { craftProfit } from "../../lib/pricemath.js";
import { FACTIONS, REGION_NAMES } from "../../lib/labels";
import { moneyText } from "../../lib/format";
import { levelingUrl, professionUrl, recipeSlug, recipeUrl } from "../../lib/urls";
import { GATHERING } from "../../data/leveling";
import { MIN_PROFESSION_RECIPES } from "../../data/catalog";
import { skillSortKey } from "../../lib/recipeinfo";
import { skillLevels, skillSentence, wowheadItem, wowheadSpell } from "../../lib/recipeinfo";

export function getStaticPaths() {
  return loadCatalog().recipes.map((r) => ({ params: { slug: recipeSlug(r.id, r.name) }, props: { r } }));
}

const { r } = Astro.props;
const c = loadCatalog();
const ph = c.primaryHouse;
const recipe = { q: r.q, item: r.item, r: r.mats };
const res = ph ? craftProfit(recipe, primaryPrices(c)) : null;
const sk = skillLevels(r.info);
const teach = r.info && r.info[3] === "item" ? r.info[4] : 0;
const teachName = teach ? ((c.names[teach] || [])[0] || "a recipe item") : null;
const itemName = r.item ? (r.itemName || (c.names[r.item] || [])[0] || r.name) : null;

// profit on every auction house that has prices for it
const houseRows = r.item
  ? c.houses.map((h) => ({ h, x: craftProfit(recipe, priceOn(c, h.region, h.houseId)) })).filter(({ x }) => x.costComplete || x.sellAh != null)
  : [];

// Some recipes exist twice under one name (an original and a newer version): the id keeps titles unique
const titleName = c.recipes.some((x) => x.name === r.name && x.id !== r.id) ? `${r.name} (ID ${r.id})` : r.name;
const description = `${titleName} (${r.prof}) in WoW: Forever: materials${res && res.costComplete ? ` cost about ${moneyText(res.cost)}` : ""}${res && res.profit != null ? `, ${res.profit >= 0 ? "profit" : "loss"} ${moneyText(Math.abs(res.profit))} after the AH cut` : ""}. Live material prices and profit on every auction house.`;
const site = Astro.site!.href.replace(/\/$/, "");
const profRecipes = c.recipes.filter((x) => x.prof === r.prof);
const profPage = profRecipes.length >= MIN_PROFESSION_RECIPES;
const crumbs = [
  { name: "Home", item: site + "/" },
  { name: "Recipes", item: site + "/recipe" },
  ...(profPage ? [{ name: r.prof, item: site + professionUrl(r.prof) }] : []),
  { name: r.name, item: site + "/recipe/" + Astro.params.slug },
];
const jsonld = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: crumbs.map((x, i) => ({ "@type": "ListItem", position: i + 1, ...x })),
};
// More recipes from the same profession at about the same skill: what to learn next
const mySkill = skillSortKey(r.info) ?? 0;
const nearby = profRecipes
  .filter((x) => x.id !== r.id)
  .map((x) => ({ x, d: Math.abs((skillSortKey(x.info) ?? 0) - mySkill) }))
  .sort((a, b) => a.d - b.d || a.x.name.localeCompare(b.x.name))
  .slice(0, 10)
  .map((e) => e.x)
  .sort((a, b) => (skillSortKey(a.info) ?? 0) - (skillSortKey(b.info) ?? 0));
---
<BaseLayout title={`${titleName}: ${r.prof} Recipe, Cost & Profit | WoW: Forever`} description={description} page="recipe" image="recipes" jsonld={jsonld}>
  <section class="page-hero page-hero-item"><div class="wrap"><div class="hero-frame">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/recipe">Recipes</a> › {profPage ? <a href={professionUrl(r.prof)}>{r.prof}</a> : r.prof} › {r.name}</nav>
    <div class="item-title">{r.item && <ItemTitleIcon id={r.item} />}<h1>{r.name}</h1></div>
    <p class="item-sub">{[r.prof, r.cat, sk ? (sk.req != null ? `needs ${r.prof} ${sk.req}` : `trainer, skill ≤ ${sk.yellow}`) : null, "WoW: Forever recipe"].filter(Boolean).join(" · ")}</p>
    <p class="item-summary">
      {r.name} is a {r.prof} recipe{r.cat ? ` (${r.cat})` : ""}{r.item ? <Fragment> that makes {r.q > 1 ? `${r.q}× ` : ""}<ItemLink id={r.item} name={itemName!} />.</Fragment> : "."}{res && res.costComplete && ph && (
        <Fragment> On {ph.label} Alliance ({REGION_NAMES[ph.region]}) the materials cost about <b><Money c={res.cost} /></b>{res.profit != null
          ? <Fragment> and the result sells for <Money c={res.sellAh} />, {res.profit >= 0 ? <Fragment>a <b>profit</b> of </Fragment> : <Fragment>a <b>loss</b> of </Fragment>}<b><Money c={Math.abs(res.profit)} /></b> after the 5% AH cut.</Fragment>
          : "."}</Fragment>
      )} Prices as of {c.asOf}.
    </p>
    <LiveFreshness />
    <div class="item-actions">
      <PlanButton recipeId={r.id} />
      <a class="btn btn-ghost" href="/planner">View my plan <span class="plan-count" data-plan-count hidden></span></a>
      <a class="btn btn-ghost" href={`/crafting?q=${encodeURIComponent(itemName || r.name)}`}>Compare with other recipes</a>
      {!GATHERING.has(r.prof) && <a class="btn btn-ghost" href={levelingUrl(r.prof)}>What leveling {r.prof} costs</a>}
      {r.item && c.hasPage.has(String(r.item)) && <a class="btn btn-ghost" href={itemPageUrl(c, r.item)}>{itemName} prices</a>}
    </div>
  </div></div></section>

  <div class="wrap section grid">
    {r.info && (
      <section class="panel">
        <h2>How to learn it</h2>
        {r.info[3] === "auto" && <p>Learned automatically when you pick up {r.prof}.</p>}
        {teach > 0 && <p>From <a class="wh" href={wowheadItem(teach)} target="_blank" rel="noopener nofollow" data-wh-rename-link="false">{teachName}</a>{sk && sk.req != null && `, which needs ${r.prof} ${sk.req}`}. Wowhead shows where it drops and who sells it.</p>}
        {r.info[3] === "trainer" && <p>Taught by {r.prof} trainers once your skill is high enough{sk && ` (at most ${sk.yellow})`}. <a class="wh" href={wowheadSpell(r.info[5])} target="_blank" rel="noopener nofollow" data-wh-rename-link="false">See which trainers on Wowhead</a>.</p>}
        {sk && (
          <p>Skill: <span class="sk sk-o">{sk.req != null ? sk.req : "≤" + sk.yellow}</span> <span class="sk sk-y">{sk.yellow}</span> <span class="sk sk-g">{sk.green}</span> <span class="sk sk-x">{sk.grey}</span>: <span class="faint">{skillSentence(sk, r.prof)}</span></p>
        )}
        <p><a class="wh" href={wowheadSpell(r.info[5])} target="_blank" rel="noopener nofollow" data-wh-rename-link="false">This recipe on Wowhead</a></p>
      </section>
    )}
    <section class="panel">
      <h2>Materials</h2>
      <div class="table-wrap">
        <table class="prices">
          <caption class="sr-only">Materials for {r.name}</caption>
          <thead><tr><th scope="col">Material</th><th scope="col" class="num">Qty</th><th scope="col" class="num">Price each</th><th scope="col">From</th><th scope="col" class="num">Cost</th></tr></thead>
          <tbody>
            {r.mats.map((m, i) => {
              const p = res?.parts[i];
              return p ? (
                <tr>
                  <th scope="row"><ItemLink id={m[0]} name={m[2]} /><CopyName name={m[2]} /></th><td class="num">{m[1]}</td>
                  <td class="num">{p.unit != null ? <Money c={p.unit} /> : <span class="faint">no price</span>}</td>
                  <td class="dim">{p.source === "ah" ? "Auction House" : p.source === "vendor" ? "Vendor (estimate)" : "-"}</td>
                  <td class="num">{p.unit != null ? <Money c={p.unit * m[1]} /> : "-"}</td>
                </tr>
              ) : (
                <tr><th scope="row"><ItemLink id={m[0]} name={m[2]} /><CopyName name={m[2]} /></th><td class="num">{m[1]}</td><td colspan="3" class="dim">-</td></tr>
              );
            })}
          </tbody>
          {res && res.costComplete && <tfoot><tr><th scope="row" colspan="4">Total materials</th><td class="num"><b><Money c={res.cost} /></b></td></tr></tfoot>}
        </table>
      </div>
      <p class="faint" style="margin-top:8px">Prices from {ph ? `${ph.label} Alliance, ${REGION_NAMES[ph.region]}` : "the Auction House"}. "Vendor (estimate)" means the material isn't on the AH, so we use Blizzard's vendor price. Check a trade vendor sells it.</p>
    </section>

    {houseRows.length > 0 && (
      <section class="panel">
        <h2>Profit on every Auction House</h2>
        <div class="table-wrap">
          <table class="prices">
            <caption class="sr-only">Crafting profit for {r.name} by auction house</caption>
            <thead><tr><th scope="col">Region</th><th scope="col">Ruleset</th><th scope="col">Auction House</th><th scope="col" class="num">Materials</th><th scope="col" class="num">Sells for</th><th scope="col" class="num">Profit</th></tr></thead>
            <tbody>
              {houseRows.map(({ h, x }) => (
                <tr>
                  <td>{REGION_NAMES[h.region]}</td><td class={h.confirmed ? undefined : "dim"}>{h.label}</td><td>{FACTIONS[h.faction]}</td>
                  <td class="num">{x.costComplete ? <Money c={x.cost} /> : "-"}</td><td class="num"><Money c={x.sellAh} /></td>
                  <td class="num">{x.profit != null ? <Fragment><span class={`pct ${x.profit >= 0 ? "up" : "down"}`}>{x.profit >= 0 ? "+" : "−"}</span> <Money c={Math.abs(x.profit)} /></Fragment> : "-"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="faint" style="margin-top:8px">Profit = sale price minus the 5% AH cut minus materials. It ignores deposits and whether the item actually sells.</p>
      </section>
    )}

    {nearby.length > 0 && (
      <section class="panel">
        <h2>More {r.prof} recipes at this skill</h2>
        <ul class="recipe-list" style="columns: 2 260px">
          {nearby.map((x) => <li><a href={recipeUrl(x.id, x.name)}>{x.name}</a>{skillSortKey(x.info) != null && <span class="faint"> · skill {skillSortKey(x.info)}</span>}</li>)}
        </ul>
        {profPage && <p class="faint" style="margin-top:8px"><a href={professionUrl(r.prof)}>All {r.prof} recipes by skill</a></p>}
      </section>
    )}

    <p class="faint">Data provided by Blizzard Entertainment. Forever Anvil is not affiliated with or endorsed by Blizzard.</p>
  </div>
  <div class="wrap"><AdSlot name="bottom" /></div>
  <Wowhead />
</BaseLayout>
