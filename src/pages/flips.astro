---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Flips from "../tools/Flips.svelte";
---
<BaseLayout
  title="WoW: Forever Vendor Flips — Easy Gold from the Auction House — Forever Tome"
  description="Find WoW: Forever auction house listings priced below what vendors pay. Buy, sell to a vendor, profit — updated hourly for every faction."
  page="flips"
>
  <PageHero icon="flips" eyebrow="Gold & auction house" title="Vendor flips" facts={[{ icon: "clock", text: "Snapshot about every hour" }, { icon: "prices", text: "Profit per item and in total" }, { icon: "character", text: "Any vendor buys them" }]}>
    Items listed on the Auction House for <b>less than a vendor pays</b> for them. Buy, walk to any vendor, sell — guaranteed profit.
  </PageHero>

  <Flips client:load>
    <div class="panel pr-help">
      <h2>Good to know</h2>
      <ul class="gems">
        <li>Prices are a snapshot taken about once an hour — other players spot flips too, so they can be gone by the time you look.</li>
        <li>"Units below vendor price" counts only the listings cheap enough to flip; buying more than that won't be profitable.</li>
        <li>Only listings with a buyout are counted. A flip must earn at least 10 copper <b>and</b> 5% of the vendor price per item — tiny margins on expensive items aren't worth the risk.</li>
        <li>Check the vendor price in the item's tooltip in-game before buying in bulk.</li>
      </ul>
      <p class="faint">Data provided by Blizzard Entertainment. Forever Tome is not affiliated with or endorsed by Blizzard.</p>
    </div>
  </Flips>
</BaseLayout>
