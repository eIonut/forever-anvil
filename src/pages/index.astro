---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonateBox from "../components/DonateBox.astro";
import Icon from "../components/Icon.astro";
import LiveFreshness from "../components/LiveFreshness.astro";
import HomeMarket from "../tools/HomeMarket.svelte";
import type { IconName } from "../lib/icons";
import config from "../config.js";
import { itemCategories, loadCatalog, loadTalents, professions, MIN_PROFESSION_RECIPES } from "../data/catalog";
import { categoryUrl, levelingUrl, professionUrl, talentClassUrl } from "../lib/urls";
import { builtRoute, GATHERING } from "../data/leveling";
import { moneyText, num } from "../lib/format";

// "Browse" links to the hub pages, so every item, recipe and class is a few clicks from here
const cat = loadCatalog();
const BROWSE = [
  { title: "Professions", links: professions(cat).filter((p) => p.recipes.length >= MIN_PROFESSION_RECIPES).map((p) => ({ href: professionUrl(p.name), label: p.name })) },
  { title: "Item prices by category", links: itemCategories(cat).map((x) => ({ href: categoryUrl(x.name), label: x.name })) },
  { title: "Talents by class", links: loadTalents().map((x) => ({ href: talentClassUrl(x.name), label: x.name })) },
].filter((b) => b.links.length);

// Spotlight: the leveling calculator with a real number from today's build, and the upgrade finder
const levelProfs = professions(cat).filter((p) => !GATHERING.has(p.name) && p.recipes.length >= MIN_PROFESSION_RECIPES && p.recipes.some((r) => r.info));
const bsRecipes = levelProfs.find((p) => p.name === "Blacksmithing")?.recipes;
const bsRoute = bsRecipes ? builtRoute(cat, bsRecipes) : null;
const bsCost = bsRoute && bsRoute.steps.length ? (bsRoute.total >= 10000 ? num(Math.round(bsRoute.total / 10000)) + "g" : moneyText(bsRoute.total)) : null;

// Site name and logo for search results (WebSite + Organization)
const site = Astro.site!.href.replace(/\/$/, "");
const jsonld = [
  { "@context": "https://schema.org", "@type": "WebSite", "@id": site + "/#website", name: config.siteName, alternateName: "Forever Anvil: WoW: Forever tools", url: site + "/", inLanguage: "en", publisher: { "@id": site + "/#org" } },
  { "@context": "https://schema.org", "@type": "Organization", "@id": site + "/#org", name: config.siteName, url: site + "/", logo: site + "/og/default.png" },
];

interface Tool {
  href: string;
  icon: IconName;
  title: string;
  desc: string;
  /** what's on the page, in a few words each */
  shows: string[];
}
interface Group {
  id: string;
  title: string;
  desc: string;
  tools: Tool[];
}

const GROUPS: Group[] = [
  {
    id: "gold", title: "Gold & auction house",
    desc: "Live Auction House data for every ruleset, refreshed about every hour.",
    tools: [
      { href: "/prices", icon: "prices", title: "Auction prices", desc: "What items really sell for, and whether to sell them on the Auction House or to a vendor.", shows: ["Market and lowest price", "Rising, falling and deals", "30-day history"] },
      { href: "/watchlist", icon: "star", title: "My watchlist", desc: "Star the items you buy and sell, see this hour's price and weekly change, and get flagged at your target price.", shows: ["Target-price flags", "Cheapest house"] },
      { href: "/economy", icon: "economy", title: "Economy", desc: "The state of your ruleset's three auction houses at a glance.", shows: ["Material prices", "Gold by category", "Cross-house flips"] },
      { href: "/flips", icon: "flips", title: "Vendor flips", desc: "Listings priced below what a vendor pays. Buy them, sell to any vendor, keep the difference.", shows: ["Profit per item", "Units worth buying"] },
      { href: "/waylaid-crates", icon: "crates", title: "Waylaid Crates", desc: "Which crate turns the least gold into Merchant's Favor, and the cheapest bundle to fill it.", shows: ["Gold per Favor", "Every bundle priced"] },
      { href: "/item", icon: "items", title: "Item price pages", desc: "Every traded item A–Z, each with its own page of prices and crafting uses.", shows: ["Prices per auction house", "What it's used in"] },
    ],
  },
  {
    id: "craft", title: "Crafting",
    desc: "Material costs from today's prices, so you know what's worth making.",
    tools: [
      { href: "/crafting", icon: "crafting", title: "Craft profits", desc: "Which recipes make gold right now, after material costs and the Auction House's 5% cut.", shows: ["Every profession", "Profit and margin"] },
      { href: "/leveling", icon: "leveling", title: "Leveling cost", desc: "What leveling a profession 1–300 costs today: the cheapest recipe at every skill and one shopping list.", shows: ["Every crafting profession", "Cheapest house per material"] },
      { href: "/planner", icon: "planner", title: "Crafting planner", desc: "Pick what you want to craft and get one shopping list for all the materials.", shows: ["What to buy where", "Total cost"] },
      { href: "/recipe", icon: "recipes", title: "Recipe pages", desc: "Every recipe by profession, with its materials, cost and profit.", shows: ["Materials list", "Cost on every house"] },
    ],
  },
  {
    id: "char", title: "Characters",
    desc: "Plan your build and look up anyone's gear.",
    tools: [
      { href: "/talents", icon: "talents", title: "Talent calculator", desc: "Plan a build with the real WoW: Forever talent trees and share it with one link.", shows: ["Every class", "Shareable link"] },
      { href: "/upgrades", icon: "upgrades", title: "AH gear upgrades", desc: "Type a character and see better gear for every slot on the Auction House right now.", shows: ["Your class and level", "Cheapest first"] },
      { href: "/character", icon: "character", title: "Character lookup", desc: "Any character's level, gear, professions and reputations.", shows: ["Equipped gear", "Professions"] },
    ],
  },
];

const STEPS: { icon: IconName; title: string; text: string }[] = [
  { icon: "globe", title: "Pick your market", text: "Choose your region, ruleset and auction house once. Every tool remembers it." },
  { icon: "clock", title: "Complete, every hour", text: "Every auction house comes straight from Blizzard's official API about once an hour. No addon, no waiting for someone to scan." },
  { icon: "lock", title: "No account needed", text: "Builds, plans and settings stay in your own browser. Nothing to sign up for." },
];
---
<BaseLayout
  title="Forever Anvil | WoW: Forever auction prices, crafting & talent tools"
  description="Free WoW: Forever tools: profession leveling cost at today's prices, AH gear upgrades for your character, live auction prices, crafting profits and talents."
  page="home"
  jsonld={jsonld}
>
  <section class="page-hero home-hero">
    <div class="wrap">
      <div class="hero-frame">
        <div class="hero-main">
          <div class="hero-text">
            <p class="eyebrow">World of Warcraft: Forever · Free fan-made tools</p>
            <h1>Tools for the new Azeroth</h1>
            <p class="lead">What your profession costs to level today, gear upgrades for your character on the AH, live auction prices and crafting profits, worked out from Blizzard's own data. Free, and no sign-up.</p>
            <div class="hero-actions">
              <a class="btn" href="/leveling"><Icon name="leveling" size={20} />Profession leveling cost</a>
              <a class="btn" href="/upgrades"><Icon name="upgrades" size={20} />Find gear upgrades</a>
              <a class="btn btn-ghost" href="/prices"><Icon name="prices" size={20} />Check auction prices</a>
            </div>
            <p class="hero-promise"><Icon name="check" size={18} /><span><b>Complete hourly data, no addon.</b> Every auction house is read straight from Blizzard every hour, so prices never wait for someone to scan.</span></p>
            <LiveFreshness brief />
          </div>
        </div>
      </div>
    </div>
  </section>

  <HomeMarket client:load />

  <section class="wrap section spotlight" aria-label="Featured tools">
    <article class="spot-card">
      <div class="spot-head"><span class="tool-icon"><Icon name="leveling" size={34} /></span><h2><a href="/leveling">What does leveling your profession cost?</a></h2></div>
      {bsCost
        ? <p class="spot-lead">Leveling <b>Blacksmithing 1→300</b> costs about <b class="spot-num">{bsCost}</b> on {bsRoute!.market} today.</p>
        : <p class="spot-lead">The cheapest way to 300 at <b>today's</b> prices.</p>}
      <p>The cheapest recipe at every skill, how many to craft, and one shopping list with the cheapest auction house for each material. Guides use last month's prices; this uses this hour's.</p>
      <p class="spot-label">Pick your profession</p>
      <div class="spot-chips">{levelProfs.map((p) => <a class="chip-link" href={levelingUrl(p.name)}>{p.name}</a>)}</div>
    </article>
    <article class="spot-card">
      <div class="spot-head"><span class="tool-icon"><Icon name="upgrades" size={34} /></span><h2><a href="/upgrades">Gear upgrades on the AH, for your character</a></h2></div>
      <p class="spot-lead">Type your name: we check <b>every item for sale</b> against what you wear.</p>
      <p>Upgrades for every slot that your class can use at your level, on your faction's auction house or Blackwater, cheapest first.</p>
      <form class="spot-form" action="/upgrades" method="get">
        <label class="sr-only" for="spot-region">Region</label>
        <select class="input" id="spot-region" name="r"><option value="eu">Europe</option><option value="kr">Korea</option><option value="tw">Taiwan</option></select>
        <label class="sr-only" for="spot-name">Character name</label>
        <input class="input" id="spot-name" name="n" placeholder="Firstname Lastname" autocomplete="off" maxlength="40" required />
        <button class="btn" type="submit">Find upgrades</button>
      </form>
      <p class="faint">Forever characters have a first and last name. Level 10+, logged out at least once.</p>
    </article>
  </section>

  <section class="wrap section" aria-labelledby="how-title">
    <h2 id="how-title" class="sr-only">How it works</h2>
    <ol class="steps">
      {STEPS.map((s) => (
        <li class="step">
          <span class="step-icon"><Icon name={s.icon} size={24} /></span>
          <div><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </section>

  {GROUPS.map((g) => (
    <section class="wrap section" aria-labelledby={`${g.id}-title`}>
      <div class="group-head">
        <h2 id={`${g.id}-title`}>{g.title}</h2>
        <p>{g.desc}</p>
      </div>
      <ul class:list={["tool-grid", { "tool-grid-2": g.tools.length % 2 === 0 }]}>
        {g.tools.map((t) => (
          <li>
            <a class="tool-card" href={t.href}>
              <span class="tool-icon"><Icon name={t.icon} size={30} /></span>
              <span class="tool-body">
                <span class="tool-title">{t.title}</span>
                <span class="tool-desc">{t.desc}</span>
                <span class="tool-shows"><span class="sr-only">Shows: </span>{t.shows.map((x) => <span class="tool-tag">{x}</span>)}</span>
              </span>
              <span class="tool-go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {BROWSE.length > 0 && (
    <section class="wrap section" aria-labelledby="browse-title">
      <div class="group-head"><h2 id="browse-title">Browse</h2><p>Jump straight to a profession, a kind of item or a class.</p></div>
      <div class="grid grid-2">
        {BROWSE.map((b) => (
          <nav class="panel" aria-label={b.title}>
            <h3>{b.title}</h3>
            <p class="az">{b.links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
          </nav>
        ))}
      </div>
    </section>
  )}

  <div class="wrap"><AdSlot name="bottom" /></div>
  <DonateBox standalone />
</BaseLayout>
