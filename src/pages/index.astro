---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonateBox from "../components/DonateBox.astro";
import Icon from "../components/Icon.astro";
import type { IconName } from "../lib/icons";

interface Tool {
  href: string;
  icon: IconName;
  title: string;
  desc: string;
  /** what's on the page, in a few words each */
  shows: string[];
}
interface Group {
  id: string;
  title: string;
  desc: string;
  tools: Tool[];
}

const GROUPS: Group[] = [
  {
    id: "gold", title: "Gold & auction house",
    desc: "Live Auction House data for every ruleset, refreshed about every hour.",
    tools: [
      { href: "/prices", icon: "prices", title: "Auction prices", desc: "What items really sell for, and whether to sell them on the Auction House or to a vendor.", shows: ["Market and lowest price", "Rising, falling and deals", "30-day history"] },
      { href: "/economy", icon: "economy", title: "Economy", desc: "The state of your ruleset's three auction houses at a glance.", shows: ["Material prices", "Where the gold is", "Blackwater flips"] },
      { href: "/flips", icon: "flips", title: "Vendor flips", desc: "Listings priced below what a vendor pays. Buy them, sell to any vendor, keep the difference.", shows: ["Profit per item", "Units worth buying"] },
      { href: "/item", icon: "items", title: "Item price pages", desc: "Every traded item A–Z, each with its own page of prices and crafting uses.", shows: ["Prices per auction house", "What it's used in"] },
    ],
  },
  {
    id: "craft", title: "Crafting",
    desc: "Material costs from today's prices, so you know what's worth making.",
    tools: [
      { href: "/crafting", icon: "crafting", title: "Craft profits", desc: "Which recipes make gold right now, after material costs and the Auction House's 5% cut.", shows: ["Every profession", "Profit and margin"] },
      { href: "/planner", icon: "planner", title: "Crafting planner", desc: "Pick what you want to craft and get one shopping list for all the materials.", shows: ["What to buy where", "Total cost"] },
      { href: "/recipe", icon: "recipes", title: "Recipe pages", desc: "Every recipe by profession, with its materials, cost and profit.", shows: ["Materials list", "Cost on every house"] },
    ],
  },
  {
    id: "char", title: "Characters",
    desc: "Plan your build and look up anyone's gear.",
    tools: [
      { href: "/talents", icon: "talents", title: "Talent calculator", desc: "Plan a build with the real WoW: Forever talent trees and share it with one link.", shows: ["Every class", "Shareable link"] },
      { href: "/character", icon: "character", title: "Character lookup", desc: "Any character's level, gear, professions and reputations.", shows: ["Equipped gear", "Professions"] },
    ],
  },
];

const STEPS: { icon: IconName; title: string; text: string }[] = [
  { icon: "globe", title: "Pick your market", text: "Choose your region, ruleset and auction house once. Every tool remembers it." },
  { icon: "clock", title: "Fresh every hour", text: "Prices come straight from Blizzard's official API about once an hour." },
  { icon: "lock", title: "No account needed", text: "Builds, plans and settings stay in your own browser. Nothing to sign up for." },
];
---
<BaseLayout
  title="Forever Tome | WoW: Forever auction prices, crafting & talent tools"
  description="Free tools for World of Warcraft: Forever: live auction house prices, vendor flips, crafting profits and planner, a talent calculator and character lookup."
  page="home"
>
  <section class="page-hero home-hero">
    <div class="wrap">
      <div class="hero-frame">
        <div class="hero-main">
          <div class="hero-text">
            <p class="eyebrow">World of Warcraft: Forever · Free fan-made tools</p>
            <h1>Tools for the new Azeroth</h1>
            <p class="lead">Live auction prices, crafting profits, talent builds and character lookups, worked out from Blizzard's own data. Free, and no sign-up.</p>
            <div class="hero-actions">
              <a class="btn" href="/prices"><Icon name="prices" size={20} />Check auction prices</a>
              <a class="btn btn-ghost" href="/crafting"><Icon name="crafting" size={20} />Find profitable crafts</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="how-title">
    <h2 id="how-title" class="sr-only">How it works</h2>
    <ol class="steps">
      {STEPS.map((s) => (
        <li class="step">
          <span class="step-icon"><Icon name={s.icon} size={24} /></span>
          <div><h3>{s.title}</h3><p>{s.text}</p></div>
        </li>
      ))}
    </ol>
  </section>

  {GROUPS.map((g) => (
    <section class="wrap section" aria-labelledby={`${g.id}-title`}>
      <div class="group-head">
        <h2 id={`${g.id}-title`}>{g.title}</h2>
        <p>{g.desc}</p>
      </div>
      <ul class:list={["tool-grid", { "tool-grid-2": g.tools.length % 2 === 0 }]}>
        {g.tools.map((t) => (
          <li>
            <a class="tool-card" href={t.href}>
              <span class="tool-icon"><Icon name={t.icon} size={30} /></span>
              <span class="tool-body">
                <span class="tool-title">{t.title}</span>
                <span class="tool-desc">{t.desc}</span>
                <span class="tool-shows"><span class="sr-only">Shows: </span>{t.shows.map((x) => <span class="tool-tag">{x}</span>)}</span>
              </span>
              <span class="tool-go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <div class="wrap"><AdSlot name="bottom" /></div>
  <DonateBox standalone />
</BaseLayout>
