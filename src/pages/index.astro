---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import DonateBox from "../components/DonateBox.astro";
---
<BaseLayout
  title="Forever Tome — WoW: Forever auction prices, crafting & talent tools"
  description="Free tools for World of Warcraft: Forever: live auction house prices, vendor flips, crafting profits and planner, a talent calculator and character lookup."
  page="home"
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">World of Warcraft: Forever · Tools</div>
      <h1>Tools for the new Azeroth</h1>
      <p class="lead">Live auction prices, crafting profits, talent builds and character lookups. Free, and no sign-up.</p>
      <div class="hero-actions">
        <a class="btn" href="/prices">Check auction prices</a>
        <a class="btn btn-ghost" href="/crafting">Find profitable crafts</a>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="gold-title">
    <div class="section-head"><h2 id="gold-title">Gold &amp; auction house</h2></div>
    <div class="start-grid">
      <a class="panel start-card" href="/prices">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="2.5" /><circle cx="24" cy="24" r="11" fill="none" stroke="currentColor" stroke-width="2" /><path d="M24 17v14M20.5 20.5h5a2.5 2.5 0 0 1 0 5h-3a2.5 2.5 0 0 0 0 5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <div><h3>Auction prices</h3><p>What items really sell for, what's rising and falling, and today's deals.</p></div>
      </a>
      <a class="panel start-card" href="/flips">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M8 16h28l-6-6M40 32H12l6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <div><h3>Vendor flips</h3><p>Items that sell on the auction house for more than a vendor charges.</p></div>
      </a>
      <a class="panel start-card" href="/item">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M10 6h22l6 6v30H10z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /><path d="M16 18h16M16 25h16M16 32h10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
        <div><h3>Item price pages</h3><p>Browse every traded item A–Z, with price history and what it crafts.</p></div>
      </a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="craft-title">
    <div class="section-head"><h2 id="craft-title">Crafting</h2></div>
    <div class="start-grid">
      <a class="panel start-card" href="/crafting">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M8 40l16-16M22 10l16 16-6 6-16-16z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M6 42h14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
        <div><h3>Craft profits</h3><p>Which recipes make gold right now, after material costs and the AH cut.</p></div>
      </a>
      <a class="panel start-card" href="/planner">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="9" y="8" width="30" height="34" rx="3" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M16 19l3 3 6-6M16 31l3 3 6-6M29 20h4M29 32h4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <div><h3>Crafting planner</h3><p>Plan what to craft and get one shopping list for all the materials.</p></div>
      </a>
      <a class="panel start-card" href="/recipe">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M12 6h20a4 4 0 0 1 4 4v32H16a4 4 0 0 1-4-4z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" /><path d="M12 38a4 4 0 0 1 4-4h20" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>
        <div><h3>Recipe pages</h3><p>Every recipe by profession, with its cost and profit.</p></div>
      </a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="char-title">
    <div class="section-head"><h2 id="char-title">Characters</h2></div>
    <div class="start-grid">
      <a class="panel start-card" href="/talents">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="10" r="5" fill="none" stroke="currentColor" stroke-width="2.5" /><circle cx="12" cy="36" r="5" fill="none" stroke="currentColor" stroke-width="2.5" /><circle cx="36" cy="36" r="5" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M21 14l-6 17M27 14l6 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
        <div><h3>Talent calculator</h3><p>Plan a build for any class and share it with a link.</p></div>
      </a>
      <a class="panel start-card" href="/character">
        <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><circle cx="24" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M8 42c2-9 8-13 16-13s14 4 16 13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
        <div><h3>Character lookup</h3><p>Any character's gear, professions and reputations.</p></div>
      </a>
    </div>
  </section>

  <div class="wrap"><AdSlot name="bottom" /></div>
  <DonateBox standalone />
</BaseLayout>
