---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DonateBox from "../components/DonateBox.astro";
import config from "../config.js";
---
<BaseLayout
  title="About & Credits — Forever Tome"
  description="About Forever Tome, an unofficial WoW: Forever fan site. Credits, sources and legal notices."
  page="about"
>
  <PageHero icon="about" eyebrow="About" title="About the Tome">
    Fan-made tools for World of Warcraft: Forever.
  </PageHero>

  <div class="wrap section grid grid-2">
    <div class="panel">
      <h2>What this site is</h2>
      <p>Forever Tome is a small set of free tools for WoW: Forever: auction house prices, vendor flips, crafting profits and a crafting planner, a talent calculator and a character lookup.</p>
      <p>Prices, recipes, talents and character profiles come from the official Blizzard API and are refreshed automatically.</p>
      {config.contactEmail && (
        <p id="contact">Spotted a mistake or want your guide listed? Email <a href={`mailto:${config.contactEmail}`}>{config.contactEmail}</a>.</p>
      )}
    </div>
    <DonateBox />
  </div>

  <div class="wrap section" id="legal">
    <div class="panel">
      <h2>Credits &amp; legal</h2>
      <ul class="gems">
        <li><b>Not affiliated with Blizzard.</b> World of Warcraft, Warcraft and Blizzard Entertainment are trademarks or registered trademarks of Blizzard Entertainment, Inc. in the U.S. and/or other countries. This site is not endorsed or sponsored by Blizzard.</li>
        <li><b>Game data.</b> Auction, item, recipe, talent and character data is provided by Blizzard Entertainment through the Blizzard Developer API.</li>
        <li><b>Artwork.</b> The logo, ornaments and page design are original to this site. Item icons and hover tooltips come from <a href="https://www.wowhead.com/forever" target="_blank" rel="noopener">Wowhead</a>'s tooltip service; game imagery belongs to Blizzard Entertainment.</li>
        <li><b>Privacy.</b> Your settings, builds and crafting plan are stored only in your browser. Read the full <a href="/privacy">privacy policy</a>.</li>
        <li><b>Corrections.</b> Prices move fast. We try to be accurate, but always check the auction house before a big purchase.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
