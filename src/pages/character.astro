---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Character from "../tools/Character.svelte";
---
<BaseLayout
  title="WoW: Forever Character Lookup | Forever Anvil"
  description="Look up any WoW: Forever character: level, race, class, guild, equipped gear, professions, reputations, and gear upgrades on the Auction House right now."
  page="character" image="character"
>
  <PageHero icon="character" eyebrow="Characters" title="Character lookup" facts={[{ icon: "upgrades", text: "With AH gear upgrades" }, { icon: "clock", text: "Live, cached up to 15 minutes" }, { icon: "privacy", text: "We don't store profiles" }]}>
    See any character's gear, professions and reputations, share the link with your guild, and find <b>gear upgrades on the Auction House</b> for every slot.
  </PageHero>

  <div class="wrap section">
    <Character client:load />
    <p class="faint" style="margin-top:16px">Data provided by Blizzard Entertainment and shown live (cached up to 15 minutes); we don't store profiles. Want a character hidden? See our <a href="/privacy">privacy policy</a>.</p>
  </div>
</BaseLayout>
