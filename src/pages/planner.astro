---
import BaseLayout from "../layouts/BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import Planner from "../tools/Planner.svelte";
---
<BaseLayout
  title="WoW: Forever Crafting Planner & Shopping List — Forever Tome"
  description="Plan your WoW: Forever crafting: add recipes, get one combined shopping list with live Auction House and vendor prices, and see your total cost and profit."
  page="planner"
>
  <section class="hero page-hero"><div class="wrap">
    <div class="eyebrow">Tool · Preview</div>
    <h1>Crafting planner</h1>
    <p class="lead">Plan what you'll craft and get one combined shopping list — what to buy on the Auction House, what from a vendor, and what it all costs right now.</p>
  </div></section>

  <Planner client:load>
    <AdSlot slot="sidebar" name="sidebar" />
  </Planner>
</BaseLayout>
