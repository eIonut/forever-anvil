---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import AdSlot from "../components/AdSlot.astro";
import Planner from "../tools/Planner.svelte";
---
<BaseLayout
  title="WoW: Forever Crafting Planner & Shopping List | Forever Anvil"
  description="Plan your WoW: Forever crafting: add recipes, get one combined shopping list with live Auction House and vendor prices, and see your total cost and profit."
  page="planner" image="planner"
>
  <PageHero icon="planner" eyebrow="Crafting" title="Crafting planner" facts={[{ icon: "planner", text: "One combined shopping list" }, { icon: "prices", text: "Live Auction House and vendor prices" }, { icon: "lock", text: "Your plan stays in this browser" }]}>
    Plan what you'll craft and get one combined shopping list: what to buy on the Auction House, what from a vendor, and what it all costs right now.
  </PageHero>

  <Planner client:load>
    <AdSlot slot="sidebar" name="sidebar" />
  </Planner>
</BaseLayout>
