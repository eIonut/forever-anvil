---
// A–Z list of every item page, with a search box.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import IndexSearch from "../../components/IndexSearch.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import Wowhead from "../../components/Wowhead.astro";
import { itemCategories, loadCatalog } from "../../data/catalog";
import { num } from "../../lib/format";
import { categoryUrl, itemUrl } from "../../lib/urls";
import { tooltipAttrs } from "../../lib/wowhead";

const c = loadCatalog();
const sorted = c.pageIds.map((id) => [id, c.names[id][0]] as const).sort((a, b) => a[1].localeCompare(b[1], "en"));
const groups: Record<string, (readonly [string, string])[]> = {};
for (const entry of sorted) {
  const key = /^[a-z]/i.test(entry[1]) ? entry[1][0].toUpperCase() : "#";
  (groups[key] ||= []).push(entry);
}
const keys = Object.keys(groups).sort();
const anchor = (k: string) => "letter-" + (k === "#" ? "num" : k);
---
<BaseLayout
  title="WoW: Forever Item Prices A–Z | Forever Anvil"
  description={`Auction House prices for ${num(sorted.length)} WoW: Forever items: market price, 30-day history, vendor price and crafting.`}
  page="items" image="items"
>
  <PageHero icon="items" eyebrow="Gold & auction house" title="WoW: Forever item prices" facts={[{ icon: "items", text: "One page per traded item" }, { icon: "clock", text: "Pages updated daily, live prices hourly" }]}>
    {num(sorted.length)} items with Auction House prices, 30-day history, vendor prices and crafting info. Updated daily (live prices hourly).
  </PageHero>

  <div class="wrap section item-index">
    <nav class="az" aria-label="Item categories">{itemCategories(c).map((cat) => <a href={categoryUrl(cat.name)}>{cat.name} <span class="faint">({num(cat.ids.length)})</span></a>)}</nav>
    <IndexSearch label="Find an item" placeholder="e.g. Copper Ore" />
    <nav class="az" aria-label="Jump to letter">{keys.map((k) => <a href={`#${anchor(k)}`}>{k}</a>)}</nav>
    {keys.map((k) => (
      <Fragment>
        <h2 id={anchor(k)}>{k}</h2>
        <ul style={`--rows:${Math.ceil(groups[k].length / 3)}`}>
          {groups[k].map(([id, name]) => {
            const q = c.names[id][4];
            return <li><a class={q ? `q-${q}` : ""} href={itemUrl(id, name)} {...tooltipAttrs(id)}><ItemIcon id={id} />{name}</a></li>;
          })}
        </ul>
      </Fragment>
    ))}
    <p class="faint">Data provided by Blizzard Entertainment. Snapshot from {c.asOf}.</p>
  </div>
  <Wowhead />
</BaseLayout>
