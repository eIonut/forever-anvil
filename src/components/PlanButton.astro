---
// "+ Add to my crafting plan" button for one recipe. Also fills in every [data-plan-count]
// badge on the page (e.g. on a "View my plan" link) with the number of planned recipes.
interface Props {
  recipeId: number;
}

const { recipeId } = Astro.props;
---
<button type="button" class="btn plan-add" data-recipe={recipeId}>+ Add to my crafting plan</button>

<script>
  import { addToPlan, updatePlanBadges } from "../lib/plan";
  import { announce } from "../lib/announce";

  updatePlanBadges();
  for (const b of document.querySelectorAll<HTMLButtonElement>(".plan-add")) {
    b.addEventListener("click", () => {
      const n = addToPlan(b.dataset.recipe || "", 1);
      const old = b.textContent;
      b.textContent = `✓ Added (${n} in plan)`;
      announce("Added to your crafting plan");
      setTimeout(() => { b.textContent = old; }, 3000);
    });
  }
</script>
