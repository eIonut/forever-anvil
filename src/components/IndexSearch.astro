---
// Search box that filters an A–Z list as you type. The lists are the <ul> elements inside
// the nearest .item-index, each after its <h2> heading (hidden when nothing in it matches).
interface Props {
  label: string;
  placeholder: string;
}

const { label, placeholder } = Astro.props;
---
<label class="field-label" for="idx-search">{label}</label>
<input class="input" type="search" id="idx-search" placeholder={placeholder} autocomplete="off" style="width:100%;max-width:420px" />

<script>
  import { announce } from "../lib/announce";

  const box = document.getElementById("idx-search") as HTMLInputElement;
  const lists = [...(box.closest(".item-index")?.querySelectorAll("ul") || [])];
  let timer: ReturnType<typeof setTimeout>;
  box.addEventListener("input", () => {
    const term = box.value.toLowerCase().trim();
    let shown = 0;
    for (const ul of lists) {
      let any = false;
      for (const li of ul.querySelectorAll("li")) {
        const hit = !term || (li.textContent || "").toLowerCase().includes(term);
        li.hidden = !hit;
        if (hit) { any = true; shown++; }
      }
      ul.hidden = !any;
      const heading = ul.previousElementSibling as HTMLElement | null;
      if (heading?.tagName === "H2") heading.hidden = !any;
    }
    clearTimeout(timer);
    timer = setTimeout(() => announce(shown + " items"), 500);
  });
</script>
