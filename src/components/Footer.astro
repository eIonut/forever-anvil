---
import config from "../config.js";
import { FOOTER_TOOLS, FOOTER_SITE } from "../lib/nav";
import DonateButton from "./DonateButton.astro";
import SettingsPanel from "./SettingsPanel.astro";
import Icon from "./Icon.astro";
---
<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="footer-brand"><img src="/img/logo.svg" alt="" width="30" height="30" />{config.siteName}</p>
        <p>Free, unofficial tools for WoW: Forever: live auction prices, crafting profits, talent builds and character lookups. Prices refresh about every hour from Blizzard's official API.</p>
        <DonateButton class="btn-sm" />
      </div>
      <nav aria-labelledby="footer-tools">
        <h2 class="footer-head" id="footer-tools">Tools</h2>
        <ul>{FOOTER_TOOLS.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="footer-site">
        <h2 class="footer-head" id="footer-site">About this site</h2>
        <ul>
          {FOOTER_SITE.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><button type="button" class="link-btn" id="open-settings" aria-haspopup="dialog" aria-expanded="false" aria-controls="settings-panel"><Icon name="settings" size={16} />Display settings</button></li>
        </ul>
      </nav>
    </div>
    <div class="legal">
      World of Warcraft, Warcraft and Blizzard Entertainment are trademarks or registered trademarks of Blizzard Entertainment, Inc.{" "}
      {config.siteName} is a fan site and is not affiliated with, endorsed or sponsored by Blizzard Entertainment. Game data provided by Blizzard Entertainment.{" "}
      <a href="/about#legal">Credits &amp; legal</a> · Last updated {config.lastUpdated}
    </div>
  </div>
  <SettingsPanel />
</footer>
