---
// A price in copper shown as coloured coins: 1,234g 40s 5c (the text stays readable without colour).
import { coins, num } from "../lib/format";

interface Props {
  c: number | null | undefined;
}

const m = coins(Astro.props.c);
const parts = m
  ? [m.g ? ["g", num(m.g) + "g"] : null, m.g || m.s ? ["s", m.s + "s"] : null, ["c", m.c + "c"]].filter((p): p is string[] => !!p)
  : [];
---
{m ? (
  <span class="money">{parts.map(([k, text], i) => <Fragment>{i > 0 && " "}<span class={`coin ${k}`}>{text}</span></Fragment>)}</span>
) : (
  <span class="faint">—</span>
)}
