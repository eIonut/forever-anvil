---
// A price in copper as in the game's money frame: number + gold/silver/copper coin icon.
// The g/s/c letters stay in the text (visually hidden) for screen readers and copy-paste.
import { coins, num } from "../lib/format";

interface Props {
  c: number | null | undefined;
}

const m = coins(Astro.props.c);
const parts = m
  ? [m.g ? ["g", num(m.g)] : null, m.g || m.s ? ["s", String(m.s)] : null, ["c", String(m.c)]].filter((p): p is string[] => !!p)
  : [];
---
{m ? (
  <span class="money">{parts.map(([k, text]) => <span class={`coin ${k}`}>{text}<span class="sr-only">{k}</span></span>)}</span>
) : (
  <span class="faint">-</span>
)}
