---
// The donate link. Shows nothing until donateUrl is set in src/config.js.
import config from "../config.js";

interface Props {
  class?: string;
}

const { class: extra } = Astro.props;
---
{config.donateUrl && (
  <a class:list={["btn btn-donate", extra]} href={config.donateUrl} target="_blank" rel="noopener" title={config.donateLabel || "Donate"}><span aria-hidden="true">&#9829;</span> <span class="donate-label">{config.donateLabel || "Donate"}</span></a>
)}
