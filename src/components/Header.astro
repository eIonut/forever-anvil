---
// Top bar: logo, main menu, menu button for narrow screens, donate button. (Display settings: in the footer.)
// The menu is plain HTML, so search engines see every link without running scripts.
import config from "../config.js";
import { NAV, isGroup, type NavLink } from "../lib/nav";
import DonateButton from "./DonateButton.astro";
import Icon from "./Icon.astro";

interface Props {
  page?: string;
}

const { page = "" } = Astro.props;
const isActive = (n: NavLink) => !!n.pages?.includes(page);
---
<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/" aria-label={`${config.siteName} home`}>
      <img src="/img/logo.svg" alt="" width="38" height="38" />
      <span><span class="brand-name">{config.siteName}</span><span class="brand-sub">{config.tagline}</span></span>
    </a>
    <nav class="nav" id="main-nav" aria-label="Main">
      {NAV.map((n, i) => {
        if (isGroup(n)) {
          // a dropdown: the button opens its links; in the phone menu the button hides and the links show in full
          const active = n.children.some(isActive);
          return (
            <div class:list={["nav-group", { active }]}>
              <button type="button" class:list={["nav-link", "nav-drop-btn", { active }]} aria-expanded="false" aria-controls={`nav-drop-${i}`}>
                {n.icon && <span class="nav-icon"><Icon name={n.icon} size={24} /></span>}
                <span class="nav-text"><span class="nav-label">{n.label}</span></span>
                <span class="nav-caret"><Icon name="chevron" size={16} /></span>
              </button>
              <div class="nav-drop" id={`nav-drop-${i}`} role="group" aria-label={n.label}>
                {n.children.map((c) => (
                  <a href={c.href} class:list={["nav-link", "nav-sub", { active: isActive(c) }]} aria-current={isActive(c) ? "page" : undefined}>
                    {c.icon && <span class="nav-icon"><Icon name={c.icon} size={28} /></span>}
                    <span class="nav-text"><span class="nav-label">{c.label}</span>{c.desc && <span class="nav-desc">{c.desc}</span>}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        }
        const active = isActive(n);
        return (
          <a href={n.href} class:list={["nav-link", { active }]} aria-current={active ? "page" : undefined}>
            {n.icon && <span class="nav-icon"><Icon name={n.icon} size={24} /></span>}
            <span class="nav-text"><span class="nav-label">{n.label}</span>{n.desc && <span class="nav-desc">{n.desc}</span>}</span>
          </a>
        );
      })}
    </nav>
    <div class="tools">
      <button type="button" class="icon-btn nav-toggle" aria-controls="main-nav" aria-expanded="false">
        <Icon name="menu" size={20} class="nav-toggle-open" />
        <Icon name="close" size={20} class="nav-toggle-close" />
        <span class="nav-toggle-text">Menu</span>
      </button>
      {(config.addonUrls?.wago || config.addonUrls?.curseforge) && (
        <a class="btn btn-ghost btn-sm header-addon" href="/addon" title="Get the in-game addon" aria-current={page === "addon" ? "page" : undefined}><Icon name="download" size={16} />Addon</a>
      )}
      <DonateButton class="btn-sm" />
    </div>
  </div>
</header>

<script>
import { onPage } from "../lib/page";
import "../lib/copyname";
import "../lib/watchlist";
import "../lib/navprogress";

  // The header is part of every page, so each navigation brings a new one to wire up.
  onPage((signal) => {
    const bar = document.querySelector<HTMLElement>(".topbar");
    const nav = document.querySelector<HTMLElement>(".nav");
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    if (!bar || !nav || !toggle) return;
    const inside = (e: Event, sel: string) => !!(e.target as Element | null)?.closest?.(sel);

    // ☰ menu (narrow screens, or whenever the links don't fit)
    function setMenu(open: boolean, focusToggle = false) {
      nav!.classList.toggle("open", open);
      toggle!.setAttribute("aria-expanded", open ? "true" : "false");
      if (!open && focusToggle) toggle!.focus();
    }
    toggle.addEventListener("click", () => {
      const open = !nav.classList.contains("open");
      setMenu(open);
      if (open) nav.querySelector("a")?.focus();
    }, { signal });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("open")) setMenu(false, true);
    }, { signal });
    document.addEventListener("click", (e) => {
      if (nav.classList.contains("open") && !inside(e, ".nav") && !inside(e, ".nav-toggle")) setMenu(false);
    }, { signal });

    // Dropdowns: click (or Enter/Space) opens one and closes the others; Escape, a click elsewhere or
    // tabbing out closes it. Hovering also shows it on mouse screens (CSS), without changing aria-expanded.
    const groups = [...nav.querySelectorAll<HTMLElement>(".nav-group")];
    function setDrop(g: HTMLElement | null, focusButton = false) {
      for (const x of groups) {
        const on = x === g;
        x.classList.toggle("open", on);
        x.querySelector(".nav-drop-btn")?.setAttribute("aria-expanded", on ? "true" : "false");
      }
      if (!g && focusButton) (document.activeElement?.closest(".nav-group")?.querySelector(".nav-drop-btn") as HTMLElement | null)?.focus();
    }
    for (const g of groups) {
      g.querySelector(".nav-drop-btn")!.addEventListener("click", () => setDrop(g.classList.contains("open") ? null : g), { signal });
      g.addEventListener("focusout", (e) => { if (!g.contains(e.relatedTarget as Node | null)) { g.classList.remove("open"); g.querySelector(".nav-drop-btn")?.setAttribute("aria-expanded", "false"); } }, { signal });
    }
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && groups.some((g) => g.classList.contains("open"))) setDrop(null, true); }, { signal });
    document.addEventListener("click", (e) => { if (!inside(e, ".nav-group")) setDrop(null); }, { signal });

    // When the links don't fit on one line, give up space step by step: the donate button shrinks to its icon
    // ("tight"), then the "Get the addon" button hides ("no-addon"), then the menu collapses into ☰ ("compact").
    function fitHeader() {
      if (nav!.classList.contains("open")) return;
      bar!.classList.remove("compact", "tight", "no-addon");
      if (getComputedStyle(nav!).display === "none") return; // already collapsed by the media query
      const over = () => nav!.scrollWidth > nav!.clientWidth + 1;
      for (const step of ["tight", "no-addon", "compact"]) {
        if (!over()) return;
        bar!.classList.add(step);
      }
    }
    fitHeader();
    window.addEventListener("resize", fitHeader, { signal });
    document.fonts?.ready.then(() => { if (!signal.aborted) fitHeader(); });
    document.addEventListener("prefs-change", fitHeader, { signal });
  });
</script>
