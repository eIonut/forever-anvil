---
// Small button that copies an item's name, for pasting into the in-game Auction House search.
// The click is handled once for the whole site in src/lib/copyname.ts. Svelte twin: src/tools/CopyName.svelte.
import Icon from "./Icon.astro";

interface Props {
  name: string;
  /** larger button, e.g. next to a page title */
  large?: boolean;
}

const { name, large = false } = Astro.props;
---
<button type="button" class:list={["copy-name", { "copy-name-lg": large }]} data-copy-name={name} title="Copy name for the Auction House search" aria-label={`Copy name: ${name}`}>
  <span class="copy-name-idle"><Icon name="copy" size={large ? 20 : 15} line /></span>
  <span class="copy-name-done"><Icon name="check" size={large ? 20 : 15} line /></span>
</button>
