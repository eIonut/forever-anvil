---
// "Keep Forever Anvil running" box. Shows nothing until donateUrl is set in src/config.js.
// standalone: put it in its own page section (when it isn't inside a grid).
import config from "../config.js";
import DonateButton from "./DonateButton.astro";

interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
const Wrap = standalone ? "div" : Fragment;
---
{config.donateUrl && (
  <Wrap {...(standalone ? { class: "wrap section" } : {})}>
    <div class="panel donate-box">
      <h3>Keep Forever Anvil running</h3>
      <p>This site is free and made by one fan. If it saved you time, a small tip pays for hosting and keeps updates coming.</p>
      <DonateButton />
    </div>
  </Wrap>
)}
