---
// The frame of every page: <head>, skip link, header, footer and back-to-top button.
// Pages fill in the middle:
//   <BaseLayout title="…" description="…" page="prices"> …page content… </BaseLayout>
import "@fontsource/alegreya-sans/400.css";
import "@fontsource/alegreya-sans/500.css";
import "@fontsource/alegreya-sans/700.css";
import "@fontsource/cinzel/500.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/cinzel-decorative/700.css";
import "../styles/global.css";
// The Latin font files the first screen uses, preloaded so they arrive with the CSS instead of after it.
// Without this the text paints in the wider fallback font first, then reflows when these swap in
// (rows of chips re-wrap and the page jumps). Same files as the @fontsource CSS above, so no double download.
import fontBody400 from "@fontsource/alegreya-sans/files/alegreya-sans-latin-400-normal.woff2?url";
import fontBody500 from "@fontsource/alegreya-sans/files/alegreya-sans-latin-500-normal.woff2?url";
import fontBody700 from "@fontsource/alegreya-sans/files/alegreya-sans-latin-700-normal.woff2?url";
import fontDisplay700 from "@fontsource/cinzel/files/cinzel-latin-700-normal.woff2?url";
import fontBrand700 from "@fontsource/cinzel-decorative/files/cinzel-decorative-latin-700-normal.woff2?url";
const preloadFonts = [fontBody400, fontBody500, fontBody700, fontDisplay700, fontBrand700];
import config from "../config.js";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
// Client-side navigation: links swap the page in place instead of reloading the browser, so the
// fonts, styles, scripts and the tools' cached data stay loaded. See src/lib/page.ts for page scripts.
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  /** which menu item to highlight, e.g. "prices" (see src/lib/nav.ts) */
  page?: string;
  jsonld?: object | object[];
  noindex?: boolean;
  /** share picture in public/og/, e.g. "prices" (see Seo.astro) */
  image?: string;
}

const { title, description, page, jsonld, noindex, image } = Astro.props;
---
<!doctype html>
<html lang="en" data-text="md">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} jsonld={jsonld} noindex={noindex} image={image} />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script is:inline>
      // Apply saved display settings before the page paints, so it doesn't flash.
      // Same as applyPrefs() in src/lib/prefs.ts, which can't be bundled into an inline script.
      try {
        var p = JSON.parse(localStorage.getItem("codex-prefs") || "null") || {};
        var h = document.documentElement;
        h.setAttribute("data-text", p.text || "md");
        if (p.contrast) h.setAttribute("data-contrast", "");
        if (p.calm) h.setAttribute("data-calm", "");
        if (p.underline) h.setAttribute("data-underline", "");
      } catch (e) { /* storage blocked: defaults */ }
      // On a client-side navigation the new page's <html> replaces these attributes:
      // copy them over before the swap so the settings stay and nothing flashes. Registered once.
      if (!window.__prefsSwap) {
        window.__prefsSwap = true;
        document.addEventListener("astro:before-swap", function (e) {
          var to = e.newDocument.documentElement, from = document.documentElement;
          ["data-text", "data-contrast", "data-calm", "data-underline"].forEach(function (a) {
            if (from.hasAttribute(a)) to.setAttribute(a, from.getAttribute(a)); else to.removeAttribute(a);
          });
        });
      }
    </script>
    {config.cfAnalyticsToken && (
      // Cloudflare Web Analytics. It loads once and stays in <head> across client-side navigation;
      // its "spa" mode counts each page swap as a page view.
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: config.cfAnalyticsToken, spa: true })}
      ></script>
    )}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header page={page} />
    <div id="sr-status" class="sr-only" role="status" aria-live="polite"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
