---
// The frame of every page: <head>, skip link, header, footer and back-to-top button.
// Pages fill in the middle:
//   <BaseLayout title="…" description="…" page="prices"> …page content… </BaseLayout>
import "@fontsource/alegreya-sans/400.css";
import "@fontsource/alegreya-sans/500.css";
import "@fontsource/alegreya-sans/700.css";
import "@fontsource/cinzel/500.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/cinzel-decorative/700.css";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
// Client-side navigation: links swap the page in place instead of reloading the browser, so the
// fonts, styles, scripts and the tools' cached data stay loaded. See src/lib/page.ts for page scripts.
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
  /** which menu item to highlight, e.g. "prices" (see src/lib/nav.ts) */
  page?: string;
  jsonld?: object | object[];
  noindex?: boolean;
}

const { title, description, page, jsonld, noindex } = Astro.props;
---
<!doctype html>
<html lang="en" data-text="md">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} jsonld={jsonld} noindex={noindex} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply saved display settings before the page paints, so it doesn't flash.
      // Same as applyPrefs() in src/lib/prefs.ts, which can't be bundled into an inline script.
      try {
        var p = JSON.parse(localStorage.getItem("codex-prefs") || "null") || {};
        var h = document.documentElement;
        h.setAttribute("data-text", p.text || "md");
        if (p.contrast) h.setAttribute("data-contrast", "");
        if (p.calm) h.setAttribute("data-calm", "");
        if (p.underline) h.setAttribute("data-underline", "");
      } catch (e) { /* storage blocked: defaults */ }
      // On a client-side navigation the new page's <html> replaces these attributes:
      // copy them over before the swap so the settings stay and nothing flashes. Registered once.
      if (!window.__prefsSwap) {
        window.__prefsSwap = true;
        document.addEventListener("astro:before-swap", function (e) {
          var to = e.newDocument.documentElement, from = document.documentElement;
          ["data-text", "data-contrast", "data-calm", "data-underline"].forEach(function (a) {
            if (from.hasAttribute(a)) to.setAttribute(a, from.getAttribute(a)); else to.removeAttribute(a);
          });
        });
      }
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header page={page} />
    <div id="sr-status" class="sr-only" role="status" aria-live="polite"></div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
