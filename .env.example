# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is excluded from git, so your secret never gets uploaded.
# Never paste these values into chat.

# From community.developer.battle.net -> API Access -> your "Forever Tome" client
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# Region to test: eu or us (kr and tw also exist)
REGION=eu

# Optional: a character to test the lookup with, as Firstname-Lastname
# (must be level 10+ and logged out at least once since reaching 10)
CHARACTER=
